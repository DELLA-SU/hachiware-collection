<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>Hachiware</AssemblyName><Version>1.4.6</Version><ApplicationIcon>character.ico</ApplicationIcon><PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><DebugType>none</DebugType></PropertyGroup>
 <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31"/></ItemGroup>
 <ItemGroup>
  <EmbeddedResource Include="character.ico" LogicalName="Assets/Hachiware.ico"/>
  <EmbeddedResource Include="../../lib/catalog.json" LogicalName="Assets/catalog.json"/>
  <EmbeddedResource Include="../../public/photos/*" LogicalName="Assets/photos/%(Filename)%(Extension)"/>
  <EmbeddedResource Include="../../public/hachiware-favicon.png" LogicalName="Assets/character.png"/>
  <EmbeddedResource Include="../../public/motion-sounds/*.wav" LogicalName="Assets/sounds/%(Filename)%(Extension)"/>
  <EmbeddedResource Include="../../public/usagi-voices/*.wav" LogicalName="Assets/voices/%(Filename)%(Extension)"/>
 </ItemGroup>
 <Target Name="RemoveUnusedWpfReference" BeforeTargets="ResolveAssemblyReferences"><ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'"/></ItemGroup></Target>
</Project>
